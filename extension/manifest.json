{
  "manifest_version": 3,
  "name": "YTBrain Logger",
  "version": "1.0.0",
  "description": "Логирует просмотренные видео YouTube для архива YTBrain",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YTBrain Logger"
  }
}
